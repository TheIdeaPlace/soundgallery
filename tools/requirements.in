# What the gallery's tools need. requirements.txt is made from this, with a hash for every file, by:
#   uv pip compile tools/requirements.in --universal --python-version 3.12 --generate-hashes -o tools/requirements.txt
# and installed with: pip install --require-hashes --no-build-isolation -r tools/requirements.txt
# (after tools/build-requirements.txt, which app-kit's build needs).
cryptography==46.0.3
pytest==8.4.2
# The scheme rules every Idea Place app shares (sounds/SCHEMES.md), pinned to one commit, and to the hash of
# GitHub's archive of it. GitHub has kept archive bytes stable, but doesn't promise to; if the hash ever stops
# matching, download the archive, check it's the same commit, and update the hash.
theideaplace-appkit @ https://github.com/TheIdeaPlace/app-kit/archive/106a4c16c954f673eb99e41c63f41bdbd717205f.zip#subdirectory=python
